---
import { getCollection } from 'astro:content';

const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.sort((a, b) => a.data.order - b.data.order);

const testimonialsJson = JSON.stringify(testimonials.map(t => ({
  quote: t.data.quote,
  quoteWoke: t.data.quoteWoke ?? t.data.quote,
  name: t.data.name,
  company: t.data.company,
  avatar: t.data.avatar,
  duration: t.data.duration,
})));
---

<section id="testimonials" class="testimonials-section">
  <div class="testimonials-container">
    <div class="testimonial-progress-wrapper">
      <div class="testimonial-progress-bar" id="testimonialProgress"></div>
    </div>
    <div class="testimonial-controls">
      <div class="testimonial-arrows">
        <button class="testimonial-btn" id="prevTestimonial" aria-label="Previous testimonial">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="testimonial-btn" id="nextTestimonial" aria-label="Next testimonial">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
      <div class="testimonial-index" id="testimonialIndex">01/0{testimonials.length}</div>
    </div>
    <div class="testimonial-tag">(real people btw)</div>
    <div
      class="testimonial-content-wrapper"
      id="testimonialContent"
      data-testimonials={testimonialsJson}
    ></div>
  </div>
</section>
