---
import { getImage } from 'astro:assets';
import { Vibrant } from 'node-vibrant/node';
import path from 'node:path';
import fs from 'node:fs';
import { generateTintedPalette, hexToHsl } from '../scripts/generate-tinted-palette.mjs';
import colorsCss from '../styles/colors.css?url';
import baseCss from '../styles/base.css?url';
import navCss from '../styles/nav.css?url';
import heroCss from '../styles/hero.css?url';
import bigTextCss from '../styles/big-text.css?url';
import projectsCss from '../styles/projects.css?url';
import testimonialsCss from '../styles/testimonials.css?url';
import faqCss from '../styles/faq.css?url';
import buttonsCss from '../styles/buttons.css?url';
import pitchCss from '../styles/pitch.css?url';
import contactCss from '../styles/contact.css?url';
import panelsCss from '../styles/panels.css?url';
import hoverStatesCss from '../styles/hover-states.css?url';

const deferredStylesheets = [
  colorsCss,
  baseCss,
  navCss,
  heroCss,
  bigTextCss,
  projectsCss,
  testimonialsCss,
  faqCss,
  buttonsCss,
  pitchCss,
  contactCss,
  panelsCss,
  hoverStatesCss,
];

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "twixxty's portfolio",
  description = "twixxty's portfolio. Just another web dev making resource-hungry sites that absolutely nobody asked for.",
} = Astro.props;

const HERO_IMAGE_FILENAME = 'pink.jpg';
const heroImages = import.meta.glob('../assets/images/*.{jpg,jpeg,png,avif}', { eager: true });
const heroBackgroundSrc = heroImages[`../assets/images/${HERO_IMAGE_FILENAME}`].default;

const optimizedHero = await getImage({
  src: heroBackgroundSrc,
  format: 'avif',
  quality: 80,
  width: 1920,
});

const heroImagePath = path.join(process.cwd(), 'src/assets/images', HERO_IMAGE_FILENAME);
const heroPalette = await Vibrant.from(heroImagePath).getPalette();

const paletteVars = Object.entries(heroPalette)
  .filter(([, swatch]) => swatch)
  .map(([name, swatch]) => {
    const kebabName = name.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
    return `--palette-${kebabName}:${swatch.hex};--palette-${kebabName}-text:${swatch.bodyTextColor}`;
  })
  .join(';');

const TINT_SATURATION = 15;
const tintSourceHex =
  heroPalette.Vibrant?.hex ??
  heroPalette.DarkVibrant?.hex ??
  heroPalette.Muted?.hex ??
  heroPalette.DarkMuted?.hex ??
  '#888888';
const { h: tintHue } = hexToHsl(tintSourceHex);

const colorsCssPath = path.join(process.cwd(), 'src/styles/colors.css');
const colorsCssText = fs.readFileSync(colorsCssPath, 'utf8');
const tintedPaletteVars = generateTintedPalette(colorsCssText, tintHue, TINT_SATURATION)
  .replace(/^:root\{/, '')
  .replace(/\}$/, '');
---
<!doctype html>
<html lang="en" style={`--hero-bg-image:url(${optimizedHero.src});${paletteVars};${tintedPaletteVars}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="twixxty, twixxty portfolio, glargle cheeseball, web developer, front-end developer, ui designer" />

    <meta property="og:title" content="twixxt" />
    <meta property="og:description" content="twixxty's personal webpage – a web developer, video editor, and tech enthusiast." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://twixxt.vercel.app" />
    <meta property="og:image" content="/images/favicon.avif" />

    <link rel="icon" type="image/avif" href="/images/favicon.avif" />


    <link rel="preload" href={optimizedHero.src} as="image" type="image/avif" />

    <link rel="preload" href="/fonts/StackSansNotch-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Poppins-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Poppins-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Poppins-Black.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/TAN-Moonlight/TAN-MOONLIGHT-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GoogleSansCode-VariableFont_MONO,wght.woff2" as="font" type="font/woff2" crossorigin />

    {deferredStylesheets.map((href) => (
      <link rel="stylesheet" href={href} media="print" onload="this.media='all';this.onload=null" />
    ))}
    <noscript>
      {deferredStylesheets.map((href) => (
        <link rel="stylesheet" href={href} />
      ))}
    </noscript>

    <style is:inline>html.lenis,html.lenis body{height:auto}.lenis-smooth{scroll-behavior:auto!important}.lenis-smooth [data-lenis-prevent]{scroll-control:none}.lenis-target{scroll-behavior:auto!important}.lenis-stopped{overflow:hidden}.lenis-scrolling iframe{pointer-events:none}.menu-overlay,.top-nav{pointer-events:none;opacity:0}.hero-bg,.hero-overlay-video,.hero-subtext,.hero-title,.nav-links-nav li,.scroll-down span,.top-nav{opacity:0}*{margin:0;padding:0;-webkit-tap-highlight-color:#fff0;box-sizing:border-box}:root{--background:#222;--font-notch:"Stack Sans Notch",sans-serif}body{background:var(--background);overflow-x:hidden}.hero{position:relative;width:100%;height:100svh;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--background)}@media (max-width:768px){.top-nav-links{display:none}}.about-side-panel{transform:translateX(100%)}.hero-bg{background:linear-gradient(rgb(0 0 0 / .45),rgb(0 0 0 / .45)),var(--hero-bg-image) center/cover no-repeat}</style>
  </head>
  <body>
    <slot />

    <script src="../scripts/main.ts"></script>
</body>
</html>
